# Docker 服务映射到宿主机的端口，默认 18008。
HOST_PORT=18008

# 推理设备，NVIDIA GPU 默认使用 cuda:0；仅使用 CPU 时可改为 cpu。
DEVICE=cuda:0

# Docker Compose 分配的 NVIDIA GPU 编号，默认使用第 0 张卡。
NVIDIA_DEVICE_ID=0

# 宿主机声纹数据库目录，默认使用项目下的 voiceprint_db。
VOICEPRINT_DB_PATH=./voiceprint_db

# 宿主机实时会议录音目录，默认使用项目下的 recordings。
RECORDINGS_PATH=./recordings

# 本地直接运行服务时的录音目录，默认使用项目下的 recordings。
RECORDINGS_DIR=./recordings

# slim 模式挂载的 Python 虚拟环境目录，默认使用 ./venv_docker。
VENV_PATH=./venv_docker

# slim 模式挂载的本地模型根目录，默认使用 ./models。
MODELS_PATH=./models

# 实时、上传和离线转写统一使用的 ASR 后端，默认 paraformer；可改为 nano。
ASR_BACKEND=paraformer

# 上传和离线转写的批处理时长上限（秒），默认 300。
UPLOAD_ASR_BATCH_SIZE_S=300

# 与 ASR_BACKEND 对应的唯一 ASR 模型路径；默认指向 Paraformer。
# 使用 nano 时改为 /app/models/asr/Fun-ASR-Nano-2512。
ASR_MODEL_PATH=/app/models/asr/speech_paraformer-large-vad-punc_asr_nat-zh-cn-16k-common-vocab8404-pytorch

# VAD 模型在容器内的路径。
VAD_MODEL_PATH=/app/models/vad/speech_fsmn_vad_zh-cn-16k-common-pytorch

# 标点恢复模型在容器内的路径。
PUNC_MODEL_PATH=/app/models/punc/punc_ct-transformer_zh-cn-common-vocab272727-pytorch

# 声纹识别模型在容器内的路径。
SPK_MODEL_PATH=/app/models/spk/speech_campplus_sv_zh-cn_16k-common

# OpenAI 兼容的 LLM API 地址，默认使用 OpenAI 官方地址。
LLM_BASE_URL=https://api.openai.com/v1

# LLM API 密钥，默认留空；启用会议总结前请填写真实密钥。
LLM_API_KEY=

# 会议总结使用的模型，默认 gpt-4o-mini。
LLM_MODEL=gpt-4o-mini

# Hugging Face 访问令牌，默认留空；下载受限模型时再填写。
HF_TOKEN=
