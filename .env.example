# Docker Compose 路径示例；本机运行时请改成实际的本机路径。
# MOSS 环境须匹配镜像的架构、Python/CUDA，不能直接复用旧业务 venv。
# 详见 docs/moss-migration.md；此模板不是通用镜像安装器。

HOST_PORT=18008
# DEVICE 控制实时/CAM++；MOSS 独立使用 CUDA，不提供 CPU/MPS 回退。
DEVICE=cuda:0
NVIDIA_DEVICE_ID=0

# 宿主机数据目录与对应容器内路径；迁移时保留旧声纹索引中的绝对路径。
VOICEPRINT_DB_PATH=./voiceprint_db
RECORDINGS_PATH=./recordings
VOICEPRINT_DB_DIR=/app/voiceprint_db
RECORDINGS_DIR=/app/recordings

# 业务 slim 环境与模型挂载，不能与 MOSS 环境混用。
VENV_PATH=./venv_docker
MODELS_PATH=./models

# 实时固定使用 FSMN-VAD + Paraformer Streaming + Nano 句末精修。
# ASR_MODEL_PATH 只指向 Nano，不再随 ASR_BACKEND 切换。
ASR_MODEL_PATH=/app/models/asr/Fun-ASR-Nano-2512
STREAMING_ASR_MODEL_PATH=/app/models/asr/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-online
VAD_MODEL_PATH=/app/models/vad/speech_fsmn_vad_zh-cn-16k-common-pytorch
SPK_MODEL_PATH=/app/models/spk/speech_campplus_sv_zh-cn_16k-common

# 离线固定使用完整音频 MOSS；先准备兼容环境，再填写容器内解释器路径。
# 当前 Compose 挂载位置为 /opt/moss，匹配后可设置 MOSS_PYTHON=/opt/moss/bin/python。
# 留空时离线请求明确失败，不会回退旧模型或上传外部语音服务。
MOSS_VENV_PATH=./venv_moss
MOSS_PYTHON=
MOSS_MODEL_PATH=/app/models/moss/MOSS-Transcribe-Diarize
MOSS_MAX_AUDIO_SECONDS=2600
MOSS_START_TIMEOUT_SECONDS=600
MOSS_TIMEOUT_SECONDS=1800
MOSS_CANCEL_TIMEOUT_SECONDS=30
MOSS_GPU_MEMORY_UTILIZATION=0.25
MOSS_CPU_THREADS=4

# 缓存必须可写；CUDA_HOME 按实际 MOSS 环境配置，不沿用旧 CUDA 12.1 路径。
# 已验证的 Python 3.11/cu13 环境示例：
# CUDA_HOME=/opt/moss/lib/python3.11/site-packages/nvidia/cu13
HF_HOME=/tmp/hf
HF_MODULES_CACHE=/tmp/hf/modules
MODELSCOPE_CACHE=/tmp/modelscope

# 摘要使用 OpenAI 兼容接口；语音本地处理不代表摘要不会发送到外部 LLM。
# 密钥留空，不启用真实摘要请求；真实凭据不要提交 Git 或写入镜像。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
